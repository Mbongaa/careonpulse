# Careon Pulse — environment variables
# Copy to .env.local (gitignored) and fill in. NEVER commit real keys.

# Live AI for the assistant (/dashboard/assistent). Server-side only — the key
# is read exclusively by src/app/api/assistant/route.ts and never reaches the
# browser. Leave empty to keep the deterministic demo answers.
OPENAI_API_KEY=

# The default is a dated snapshot for reproducibility. Change only after the
# live eval suite passes for the candidate model.
# OPENAI_MODEL=gpt-4o-mini-2024-07-18

# Responses API is the production default. Set "chat" only as a temporary
# compatibility fallback.
# OPENAI_API_MODE=responses

# Optional provider base URL. For an approved EU OpenAI endpoint, set its
# /v1 URL here; otherwise the public OpenAI API is used.
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# Set to 0 to force the deterministic fallback even when a key is present
# (used by the Playwright suite).
# CAREON_ASSISTANT_LIVE=1

# Runtime safeguards.
# CAREON_ASSISTANT_TIMEOUT_MS=45000
# CAREON_ASSISTANT_DATABASE_TIMEOUT_MS=6000
# CAREON_ASSISTANT_MAX_RETRIES=2
# CAREON_ASSISTANT_RATE_LIMIT_PER_MINUTE=20
# CAREON_ASSISTANT_RATE_LIMIT_PER_DAY=500
# CAREON_ASSISTANT_AUDIT_RATE_LIMIT_PER_MINUTE=60
# CAREON_ASSISTANT_AUDIT_RATE_LIMIT_PER_DAY=2000
# CAREON_ASSISTANT_EVENT_RETENTION_DAYS=90
# CAREON_ASSISTANT_SAFETY_SALT=replace-with-a-long-random-server-secret
# OPENAI_MODERATION_ENABLED=1

# Vercel Cron sends this value as `Authorization: Bearer ...` to the daily
# maintenance route. Required by `/api/health/ready`.
CRON_SECRET=

# Chat text is session-only by default and cleared on logout. Set "local" only
# after an explicit privacy decision; "off" keeps history in memory only.
# NEXT_PUBLIC_CAREON_ASSISTANT_HISTORY_STORAGE=session
# NEXT_PUBLIC_CAREON_ASSISTANT_HISTORY_RETENTION_DAYS=7

# --- Productie-modus: centrale opslag via Supabase (optioneel) ---
# Zonder deze variabelen werkt productie-modus lokaal (browser-opslag); met
# Supabase geconfigureerd wordt elke EPD-import centraal bewaard zodat alle
# gebruikers dezelfde data zien en er historie ontstaat.
# 1. Maak een Supabase-project aan in een EU-regio (AVG).
# 2. Voer alle bestanden in supabase/migrations op volgorde uit (0001–0008).
# 3. Vul alle drie de waarden in en herstart de app — zonder sync-token blijft
#    de route uitgeschakeld (501).
# LET OP: de service-role key is een server-side geheim — nooit NEXT_PUBLIC_,
# nooit committen. Zie PRODUCTION_MODE.md voor auth-vereisten vóór publieke
# hosting van echte data.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Sync-token: verplicht wanneer Supabase is geconfigureerd. De API-route
# weigert verzoeken zonder dit token. Het zit in de client-bundle (NEXT_PUBLIC_)
# en is dus een drempel tegen scanners en toevallige bezoekers — GÉÉN
# authenticatie. Host een deployment met echte EPD-data niet publiek voordat
# echte auth (Supabase Auth/SSO) de demo-login vervangt. Kies een lange
# willekeurige waarde (bijv. `openssl rand -hex 24`).
# NA WIJZIGEN: opnieuw builden (`npm run build`) — NEXT_PUBLIC_-waarden worden
# tijdens de build in de client-bundle gebakken; alleen herstarten laat de
# server een ander token eisen dan de client stuurt (elke sync faalt dan stil).
NEXT_PUBLIC_CAREON_SYNC_TOKEN=
