# Careon Pulse — environment variables
# Copy to .env.local (gitignored) and fill in. NEVER commit real keys.

# Live AI for the assistant (/dashboard/assistent). Server-side only — the key
# is read exclusively by src/app/api/assistant/route.ts and never reaches the
# browser. Leave empty to keep the deterministic demo answers.
OPENAI_API_KEY=

# Optional: override the model (default gpt-4o-mini).
# OPENAI_MODEL=gpt-4o-mini

# Set to 0 to force the deterministic fallback even when a key is present
# (used by the Playwright suite).
# CAREON_ASSISTANT_LIVE=1
