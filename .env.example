# Careon Pulse — environment variables
# Copy to .env.local (gitignored) and fill in. NEVER commit real keys.

# Live AI for the assistant (/dashboard/assistent). Server-side only — the key
# is read exclusively by src/app/api/assistant/route.ts and never reaches the
# browser. Leave empty to keep the deterministic demo answers.
OPENAI_API_KEY=

# The default is a dated snapshot for reproducibility. Change only after the
# live eval suite passes for the candidate model.
# OPENAI_MODEL=gpt-4o-mini-2024-07-18

# Responses API is the production default. Set "chat" only as a temporary
# compatibility fallback.
# OPENAI_API_MODE=responses

# Optional provider base URL. For an approved EU OpenAI endpoint, set its
# /v1 URL here; otherwise the public OpenAI API is used.
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# Set to 0 to force the deterministic fallback even when a key is present
# (used by the Playwright suite).
# CAREON_ASSISTANT_LIVE=1

# Base URL for the manual live-assistant smoke script
# (src/scripts/e2e-assistant-live.ts). Dev/CI only — never read by the app.
# CAREON_E2E_BASE=http://localhost:3210

# Alleen voor expliciete lokale demo's en de geïsoleerde Playwright-build.
# Laat leeg/0 in iedere echte deployment. Ontbrekende Supabase-configuratie
# valt zonder deze vlag fail-closed terug op HTTP 503, nooit op demo-auth.
# CAREON_DEMO_MODE=0

# Runtime safeguards.
# CAREON_ASSISTANT_TIMEOUT_MS=45000
# CAREON_ASSISTANT_DATABASE_TIMEOUT_MS=6000
# CAREON_ASSISTANT_MAX_RETRIES=2
# CAREON_ASSISTANT_RATE_LIMIT_PER_MINUTE=20
# CAREON_ASSISTANT_RATE_LIMIT_PER_DAY=500
# CAREON_ASSISTANT_AUDIT_RATE_LIMIT_PER_MINUTE=60
# CAREON_ASSISTANT_AUDIT_RATE_LIMIT_PER_DAY=2000
# CAREON_ASSISTANT_EVENT_RETENTION_DAYS=90
# CAREON_ASSISTANT_SAFETY_SALT=replace-with-a-long-random-server-secret
# OPENAI_MODERATION_ENABLED=1

# Vercel Cron sends this value as `Authorization: Bearer ...` to the daily
# maintenance route. Required by `/api/health/ready`.
CRON_SECRET=

# Chat text is session-only by default and cleared on logout. Set "local" only
# after an explicit privacy decision; "off" keeps history in memory only.
# (Demo-modus; in Supabase-modus is de centrale opslag per account de bron en
# is browseropslag alleen cache.)
# NEXT_PUBLIC_CAREON_ASSISTANT_HISTORY_STORAGE=session
# NEXT_PUBLIC_CAREON_ASSISTANT_HISTORY_RETENTION_DAYS=7

# Centrale chat-retentie in Supabase-modus (dagen, default 30; opgeruimd door
# de onderhoudsroute). LET OP: de AVG-melding op de assistentpagina noemt
# "maximaal 30 dagen" — pas die tekst aan als je dit wijzigt.
# CAREON_ASSISTANT_CHAT_RETENTION_DAYS=30

# Audit-logboek-retentie (dagen, default 365) en de brute-force-rem op
# /api/auth/login (per gehasht bezoekers-IP; alleen actief in Supabase-modus).
# CAREON_AUDIT_RETENTION_DAYS=365

# Facturatie (handoff 15): verlaten CONCEPTEN worden na dit aantal dagen
# opgeruimd door de maintenance-cron (min. 30). Uitgereikte facturen vallen
# buiten élke opschoning (bewaarplicht 7 jaar).
# CAREON_FACTURATIE_CONCEPT_RETENTION_DAYS=180

# --- Facturatie fase B: e-mailverzending (Resend — platformbrede keuze, D19) ---
# Eigenaarskeuze 13-08-2026, in afwijking van het EU-soevereine voorstel:
# Resend is een VS-bedrijf (DPF/SCC-afhankelijkheid) — consequenties en
# motivering in blueprint D19.
# FAIL-CLOSED: zolang de drie CAREON_MAIL_-sleutels leeg zijn antwoordt de
# verzendroute 503 en kan er niets worden verzonden. Pas invullen NÁ het
# sluiten van de verwerkersovereenkomst (DPA incl. SCC's) met Resend en het inrichten van
# DKIM/SPF op het afzenderdomein — go-live-checklist in PRODUCTION_MODE.md.
# Server-side secrets (Vercel-secret-store) — nooit NEXT_PUBLIC_.
# CAREON_MAIL_RESEND_API_KEY=
# CAREON_MAIL_AFZENDER_EMAIL=facturatie@voorbeeld.nl
# CAREON_MAIL_AFZENDER_NAAM=Careon Pulse
# CAREON_MAIL_RATE_LIMIT_PER_MINUTE=5
# CAREON_MAIL_RATE_LIMIT_PER_DAY=100
# CAREON_LOGIN_RATE_LIMIT_PER_MINUTE=10
# CAREON_LOGIN_RATE_LIMIT_PER_DAY=150

# --- Centrale opslag + echte accounts via Supabase (vereist buiten demo) ---
# De lokale demo-login (user1/demo1234, sessionStorage) werkt uitsluitend met
# CAREON_DEMO_MODE=1. Met Supabase geconfigureerd
# gelden echte accounts (Supabase Auth, cookie-sessies, afgedwongen in
# src/proxy.ts en elke API-route) en wordt alle registratiedata centraal en
# per organisatie bewaard (RLS, zie handoff 13).
# 1. Maak een Supabase-project aan in een EU-regio (AVG).
# 2. Voer alle bestanden in supabase/migrations in bestandsvolgorde uit.
# 3. Vul de drie waarden in en herstart de app.
# LET OP: de service-role key is een server-side geheim — nooit NEXT_PUBLIC_,
# nooit committen. De anon key is publiek by design (RLS beschermt de data).
# NA WIJZIGEN van NEXT_PUBLIC_-waarden: opnieuw builden (`npm run build`) —
# die worden tijdens de build in de client-bundle gebakken.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Organization that owns the local TGC browser connector. Optional; defaults
# to the current production slug. The TGC username/password themselves belong
# only in ignored `.env.tgc.local`, never in Vercel or client code.
CAREON_TGC_ORG_SLUG=tgc

# Canonieke app-URL (bijv. https://pulse.voorbeeld.nl, zonder slash op het
# eind). Hierop bouwt /api/org/members de wachtwoord-links voor nieuwe leden.
# Laat leeg en de route gebruikt de Origin van de beheerder — nooit Host of
# x-forwarded-host, want die kiest de aanvrager zelf en zou de link mét token
# naar een vreemd domein wijzen. In productie invullen.
CAREON_PUBLIC_APP_URL=

# --- Microsoft Entra ID-login via Supabase (D20) ---
# Pas op 1 zetten nadat TGC-IT de single-tenant app-registratie heeft gemaakt,
# de Azure-provider in Supabase is geconfigureerd én de callback-URL hieronder
# in Supabase Redirect URLs staat. Zonder de vlag blijft de knop fail-closed
# verborgen; demo/e2e blijft exact het wachtwoordpad gebruiken.
# Entra Web redirect (login-app):
#   https://jdxvrczwelxlgtzyisea.supabase.co/auth/v1/callback
# Supabase Redirect URL (dashboard):
#   https://<careon-host>/api/auth/callback
# Voeg in de Entra-app de optionele ID-/access-tokenclaim `xms_edov` toe zodat
# Supabase het teruggegeven e-mailadres aantoonbaar als geverifieerd behandelt.
# CAREON_MICROSOFT_LOGIN_ENABLED=0

# --- G01 / D22: Entra-gated automatische werknemersprovisioning ---
# Normale medewerkers hoeven na activatie geen Careon-uitnodiging: hun eerste
# Microsoft-login maakt uitsluitend een `member`-lidmaatschap aan wanneer het
# Azure-token de verwachte tenant, `acct=0`, xms_edov en app-rol bevat.
# Configureer in de D20 Entra-app de optionele ID-tokenclaim `acct`, de app-rol
# `Careon.User`, zet "Assignment required" aan en wijs de goedgekeurde
# Careon-gebruikers/groep aan die rol toe.
#
# FAIL-CLOSED: de callback weigert onbekende accounts zolang de schakel 0/leeg
# is, een veld ontbreekt of een claim afwijkt. Alle waarden zijn server-side;
# maak hiervan nooit NEXT_PUBLIC_-variabelen. Zet pas op 1 nadat migratie
# `*_entra_jit_membership.sql` is toegepast en de afwijspaden in Entra zijn
# getest (niet-toegewezen, gast/ontbrekend acct, verkeerde tenant, rol, mismatch).
# CAREON_ENTRA_JIT_ENABLED=0
# CAREON_ENTRA_JIT_ORG_SLUG=tgc
# CAREON_ENTRA_JIT_TENANT_ID=00000000-0000-0000-0000-000000000000
# CAREON_ENTRA_JIT_REQUIRED_APP_ROLE=Careon.User

# --- G01-B/C: volledige Entra-inventaris + lifecycle-reconciliatie ---
# Aparte appregistratie; NOOIT de D20-loginsecret of D21 persoonlijke Graph-
# registratie hergebruiken. `User.Read.All` leest alle directory-identiteiten;
# kies daarnaast exact één read-only eligibility-bron:
# - `app_role_assignments` (TGC-interim zonder P1/P2): directe `Careon.User`-
#   toewijzingen; Graph application permissions `Application.Read.All` +
#   `User.Read.All`.
# - `group` (na correcte P1/P2-licenties): expliciete groep; permissions
#   `GroupMember.Read.All` + `User.Read.All`.
# Beide modi hebben admin consent nodig en nooit write-permissions.
# CAREON_ENTRA_DIRECTORY_ENABLED=0
# CAREON_ENTRA_DIRECTORY_SOURCE=app_role_assignments
# CAREON_ENTRA_DIRECTORY_TENANT_ID=00000000-0000-0000-0000-000000000000
# CAREON_ENTRA_DIRECTORY_CLIENT_ID=00000000-0000-0000-0000-000000000000
# CAREON_ENTRA_DIRECTORY_CLIENT_SECRET=
# Alleen voor `app_role_assignments`:
# CAREON_ENTRA_DIRECTORY_SERVICE_PRINCIPAL_ID=00000000-0000-0000-0000-000000000000
# CAREON_ENTRA_DIRECTORY_APP_ROLE_ID=00000000-0000-0000-0000-000000000000
# Alleen voor `group`:
# CAREON_ENTRA_DIRECTORY_GROUP_ID=00000000-0000-0000-0000-000000000000
# CAREON_ENTRA_DIRECTORY_ORG_SLUG=tgc

# Afzonderlijke, read-only YAAZ-statuskoppeling voor dezelfde Directie-weergave.
# Deze bearer secret is uniek voor deze server-to-server route en wordt nooit als
# NEXT_PUBLIC_ gepubliceerd of hergebruikt als OIDC/Graph-token.
# CAREON_YAAZ_DIRECTORY_ENABLED=0
# CAREON_YAAZ_DIRECTORY_URL=https://<yaaz-host>/microsoft-365/internal-directory
# CAREON_YAAZ_DIRECTORY_KEY=
# CAREON_YAAZ_DIRECTORY_ORG_SLUG=tgc

# G01-C/G15: hourly Entra eligibility reconciliation. The write-capable YAAZ
# lifecycle boundary deliberately uses a different bearer from directory read.
# CAREON_ENTRA_LIFECYCLE_ENABLED=0
# CAREON_ENTRA_LIFECYCLE_MISSING_RUNS=2
# CAREON_YAAZ_LIFECYCLE_ENABLED=0
# CAREON_YAAZ_LIFECYCLE_URL=https://<yaaz-host>/microsoft-365/internal-lifecycle
# CAREON_YAAZ_LIFECYCLE_KEY=
# CAREON_YAAZ_LIFECYCLE_ORG_SLUG=tgc

# --- Supabase Management API (migraties toepassen, ad-hoc DB-queries) ---
# Persoonlijk toegangstoken van supabase.com (Account > Access Tokens, "sbp_...").
# Nodig om migraties toe te passen en om pg_policies/pg_class te bevragen; de
# service-role-sleutel kan GEEN DDL. Account-breed geldig: behandel als hoofdsleutel.
# Project-ref careon-zsg: jdxvrczwelxlgtzyisea
SUPABASE_ACCESS_TOKEN=

# --- Module 2: YAAZ (communicatie / HumHub op de comms-plane) ---
# Volledige URL van de YAAZ-module. Gezet => de YAAZ-tegel in /modules wordt een
# live (externe) link; leeg => tegel toont "Binnenkort beschikbaar". Build-time
# inlined (NEXT_PUBLIC_): na wijzigen dev-server herstarten / opnieuw bouwen.
# ⚠ ALTIJD de SSO-start-URL gebruiken (<humhub-base>/user/auth/external?authclient=careon),
# NIET de kale host — de kale host toont YAAZ's eigen loginpagina i.p.v. naadloze SSO.
# Lokaal:    http://localhost/user/auth/external?authclient=careon
# Productie: https://157-90-231-67.sslip.io/user/auth/external?authclient=careon
#            (sslip-host tijdelijk tot het platformdomein er is; §19)
NEXT_PUBLIC_YAAZ_URL=
