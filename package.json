{
  "name": "studio-admin",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "prepare": "husky",
    "generate:presets": "ts-node -P tsconfig.scripts.json src/scripts/generate-theme-presets.ts",
    "verify:careon": "ts-node -r tsconfig-paths/register -P tsconfig.scripts.json src/scripts/verify-careon.ts",
    "verify:assistant": "ts-node -P tsconfig.scripts.json src/scripts/verify-assistant-production.ts",
    "verify:runtime": "ts-node -r tsconfig-paths/register -P tsconfig.scripts.json src/scripts/verify-runtime-hardening.ts",
    "verify:assistant:live": "ts-node -P tsconfig.scripts.json src/scripts/e2e-assistant-live.ts",
    "verify:data-hygiene": "ts-node -P tsconfig.scripts.json src/scripts/verify-data-hygiene.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "audit:production": "npm audit --audit-level=high",
    "test:e2e": "node src/scripts/run-isolated-e2e.mjs",
    "verify:production": "ts-node -P tsconfig.scripts.json src/scripts/verify-production.ts",
    "verify:ci": "npm run check && npm run typecheck && npm run verify:data-hygiene && npm run verify:careon && npm run verify:production && npm run verify:assistant && npm run verify:runtime && npm run audit:production",
    "push:production": "ts-node -P tsconfig.scripts.json src/scripts/push-production.ts"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": ["biome check --write --no-errors-on-unmatched"]
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.5",
    "@assistant-ui/react-markdown": "^0.14.0",
    "@base-ui/react": "^1.6.0",
    "@shadcn/react": "^0.1.0",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "assistant-stream": "^0.3.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.7.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.23.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.1",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.1",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "postcss": "8.5.25",
    "shadcn": "4.16.0",
    "tailwindcss": "^4.1.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "brace-expansion": "5.0.8",
    "fast-uri": "3.1.4",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
